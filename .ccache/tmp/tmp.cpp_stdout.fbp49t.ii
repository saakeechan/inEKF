      typename TranspositionType::StorageIndex,
      (((int)MatrixType::RowsAtCompileTime == 0 || (int)MatrixType::ColsAtCompileTime == 0) ? 0 : ((int)MatrixType::RowsAtCompileTime == 1 || (int)MatrixType::ColsAtCompileTime == 1) ? 1 : ((int)MatrixType::RowsAtCompileTime == Dynamic && (int)MatrixType::ColsAtCompileTime == Dynamic) ? Dynamic : ((int)MatrixType::RowsAtCompileTime == Dynamic) ? (int)MatrixType::ColsAtCompileTime : ((int)MatrixType::ColsAtCompileTime == Dynamic) ? (int)MatrixType::RowsAtCompileTime : ((int)MatrixType::RowsAtCompileTime <= (int)MatrixType::ColsAtCompileTime) ? (int)MatrixType::RowsAtCompileTime : (int)MatrixType::ColsAtCompileTime)>
