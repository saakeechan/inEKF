    Packet2d iA1, iA2, iB1, iB2, iC1, iC2, iD1, iD2;


    iD1 = pmul(AB1, Packet2d(_mm_shuffle_pd(C1,C1,(0<<1)|0)));
    iD2 = pmul(AB1, Packet2d(_mm_shuffle_pd(C2,C2,(0<<1)|0)));
    iD1 = padd(iD1, pmul(AB2, Packet2d(_mm_shuffle_pd(C1,C1,(1<<1)|1))));
    iD2 = padd(iD2, pmul(AB2, Packet2d(_mm_shuffle_pd(C2,C2,(1<<1)|1))));
