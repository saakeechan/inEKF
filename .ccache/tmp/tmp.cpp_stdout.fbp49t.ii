    iA2 = padd(iA2, pmul(DC2, Packet2d(_mm_shuffle_pd(B2,B2,(1<<1)|1))));
    dD = Packet2d(_mm_shuffle_pd(dD,dD,(0<<1)|0));
    iA1 = psub(pmul(A1, dD), iA1);
    iA2 = psub(pmul(A2, dD), iA2);


