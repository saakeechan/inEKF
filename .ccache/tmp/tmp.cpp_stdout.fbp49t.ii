           ,class OverflowHandler
           ,class Float2IntRounder
           ,class RawConverter
           ,class UserRangeChecker
          >
  struct get_converter_impl
  {
# 574 "/usr/include/boost/numeric/conversion/detail/converter.hpp" 3 4
