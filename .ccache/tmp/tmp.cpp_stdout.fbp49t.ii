      i = Ci[pk];
      p1 = Cp[i];
      p2 = p1 + elen[i] - 1;
      pn = p1;
      for(h = 0, d = 0, p = p1; p <= p2; p++)
      {
        e = Ci[p];
        if(w[e] != 0)
        {
          dext = w[e] - mark;
          if(dext > 0)
          {
            d += dext;
            Ci[pn++] = e;
            h += e;
          }
          else
          {
            Cp[e] = amd_flip (k);
            w[e] = 0;
          }
        }
      }
      elen[i] = pn - p1 + 1;
      p3 = pn;
      p4 = p1 + len[i];
      for(p = p2 + 1; p < p4; p++)
      {
        j = Ci[p];
        if((nvj = nv[j]) <= 0) continue;
        d += nvj;
        Ci[pn++] = j;
        h += j;
      }
      if(d == 0)
      {
        Cp[i] = amd_flip (k);
        nvi = -nv[i];
        dk -= nvi;
        nvk += nvi;
        nel += nvi;
        nv[i] = 0;
        elen[i] = -1;
      }
      else
      {
