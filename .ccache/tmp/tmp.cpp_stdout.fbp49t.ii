  Eigen::internal::check_size_for_overflow<bool>(rows); bool* mask = (0)!=0 ? (0) : reinterpret_cast<bool*>( (sizeof(bool)*rows<=131072) ? reinterpret_cast<void*>((internal::UIntPtr(__builtin_alloca (sizeof(bool)*rows+16 -1)) + 16 -1) & ~(std::size_t(16 -1))) : Eigen::internal::aligned_malloc(sizeof(bool)*rows) ); Eigen::internal::aligned_stack_memory_handler<bool> mask_stack_memory_destructor((0)==0 ? mask : 0,rows,sizeof(bool)*rows>131072);
  Eigen::internal::check_size_for_overflow<ResScalar>(rows); ResScalar* values = (0)!=0 ? (0) : reinterpret_cast<ResScalar*>( (sizeof(ResScalar)*rows<=131072) ? reinterpret_cast<void*>((internal::UIntPtr(__builtin_alloca (sizeof(ResScalar)*rows+16 -1)) + 16 -1) & ~(std::size_t(16 -1))) : Eigen::internal::aligned_malloc(sizeof(ResScalar)*rows) ); Eigen::internal::aligned_stack_memory_handler<ResScalar> values_stack_memory_destructor((0)==0 ? values : 0,rows,sizeof(ResScalar)*rows>131072);
  Eigen::internal::check_size_for_overflow<Index>(rows); Index* indices = (0)!=0 ? (0) : reinterpret_cast<Index*>( (sizeof(Index)*rows<=131072) ? reinterpret_cast<void*>((internal::UIntPtr(__builtin_alloca (sizeof(Index)*rows+16 -1)) + 16 -1) & ~(std::size_t(16 -1))) : Eigen::internal::aligned_malloc(sizeof(Index)*rows) ); Eigen::internal::aligned_stack_memory_handler<Index> indices_stack_memory_destructor((0)==0 ? indices : 0,rows,sizeof(Index)*rows>131072);

  std::memset(mask,0,sizeof(bool)*rows);

  evaluator<Lhs> lhsEval(lhs);
  evaluator<Rhs> rhsEval(rhs);







  Index estimated_nnz_prod = lhsEval.nonZerosEstimate() + rhsEval.nonZerosEstimate();

  res.setZero();
  res.reserve(Index(estimated_nnz_prod));

  for (Index j=0; j<cols; ++j)
  {

    res.startVec(j);
    Index nnz = 0;
    for (typename evaluator<Rhs>::InnerIterator rhsIt(rhsEval, j); rhsIt; ++rhsIt)
    {
      RhsScalar y = rhsIt.value();
      Index k = rhsIt.index();
      for (typename evaluator<Lhs>::InnerIterator lhsIt(lhsEval, k); lhsIt; ++lhsIt)
      {
