template<>
struct flush_device_impl<ostream_tag> {
    template<typename T>
    static bool flush(T& t)
    { return t.rdbuf()->pubsync() == 0; }
};

template<>
struct flush_device_impl<streambuf_tag> {
    template<typename T>
