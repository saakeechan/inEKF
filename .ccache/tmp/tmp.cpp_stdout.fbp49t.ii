    iB2 = psub(iB2, pmul(Packet2d(_mm_shuffle_pd(D2,D2,1)), Packet2d(_mm_shuffle_pd(AB2,AB1,2))));
    dB = Packet2d(_mm_shuffle_pd(dB,dB,(0<<1)|0));
    iB1 = psub(pmul(C1, dB), iB1);
    iB2 = psub(pmul(C2, dB), iB2);


    iC1 = pmul(A1, Packet2d(_mm_shuffle_pd(DC2,DC1,1)));
    iC2 = pmul(A2, Packet2d(_mm_shuffle_pd(DC2,DC1,1)));
