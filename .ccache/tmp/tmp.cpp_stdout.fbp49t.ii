    m_functor.assignCoeff(m_dst.coeffRef(col,row), numext::conj(tmp));
  }

  void assignDiagonalCoeff(Index id)
  {
    Base::assignCoeff(id,id);
  }

  void assignOppositeCoeff(Index, Index)
  { ; }
};

