  Evaluator tensor(eval, DefaultDevice());
  tensor.evalSubExprsIfNeeded(
# 66 "/usr/include/eigen3/unsupported/Eigen/CXX11/src/Tensor/TensorIO.h" 3 4
                             __null
# 66 "/usr/include/eigen3/unsupported/Eigen/CXX11/src/Tensor/TensorIO.h"
                                 );


  static const int rank = internal::array_size<Dimensions>::value;
  internal::TensorPrinter<Evaluator, rank>::run(os, tensor);


  tensor.cleanup();
  return os;
}

