static const int kLeafSize = 1024;

template <typename Self, typename Op>
struct InnerMostDimReducer<Self, Op, false, true> {
  static 
# 203 "/usr/include/eigen3/unsupported/Eigen/CXX11/src/Tensor/TensorReduction.h" 3 4
                          inline 
# 203 "/usr/include/eigen3/unsupported/Eigen/CXX11/src/Tensor/TensorReduction.h"
