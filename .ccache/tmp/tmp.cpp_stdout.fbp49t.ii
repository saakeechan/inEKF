# 123 "/usr/include/boost/property_tree/xml_parser.hpp" 3 4
    template<class Ptree>
    void write_xml(const std::string &filename,
                   const Ptree &pt,
                   const std::locale &loc = std::locale(),
                   const xml_writer_settings<
                       typename Ptree::key_type
                   > & settings = xml_writer_settings<typename Ptree::key_type>())
    {
        std::basic_ofstream<typename Ptree::key_type::value_type>
            stream(filename.c_str());
        if (!stream)
            ::boost::throw_exception(xml_parser_error( "cannot open file", filename, 0), ::boost::source_location("/usr/include/boost/property_tree/xml_parser.hpp", 134, __PRETTY_FUNCTION__))
                                                 ;
        stream.imbue(loc);
        write_xml_internal(stream, pt, filename, settings);
    }

} } }

