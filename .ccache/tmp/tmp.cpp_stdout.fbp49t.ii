# 1616 "/usr/include/eigen3/unsupported/Eigen/CXX11/../src/SpecialFunctions/SpecialFunctionsImpl.h"
                                                  ;
    const Scalar big = cephes_helper<Scalar>::big();
    const Scalar machep = cephes_helper<Scalar>::machep();
