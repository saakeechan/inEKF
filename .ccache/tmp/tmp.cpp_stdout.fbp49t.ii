inline Status ExternalInitializerInfo::Create(const char* filepath, int64_t file_offset, size_t byte_size,
                                                      ExternalInitializerInfo& out) {
  OrtExternalInitializerInfo* info = nullptr;
  OrtStatus* status = GetApi().CreateExternalInitializerInfo(filepath, file_offset, byte_size, &info);
  if (status != nullptr) {
