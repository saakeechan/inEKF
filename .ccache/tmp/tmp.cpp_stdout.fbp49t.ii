    void set_needs_close()
    {
        flags_ &= ~(f_input_closed | f_output_closed);
    }
    virtual void set_next(linked_streambuf<Ch, Tr>* ) { }
    virtual void close_impl(std::ios::openmode) = 0;
    virtual bool auto_close() const = 0;
