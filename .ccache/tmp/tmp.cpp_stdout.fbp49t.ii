    template <typename Derived>
    static Eigen::Matrix<typename Derived::Scalar, 3, 3> EulerXYZ_to_R_bw(const Eigen::MatrixBase<Derived> &eul)
    {
        Eigen::Matrix<typename Derived::Scalar, 3, 3> R_matrix;


