 inline 
# 164 "/usr/include/eigen3/unsupported/Eigen/CXX11/src/Tensor/TensorConvolution.h"
                                       Index mapGpuInputKernelToTensorInputOffset(Index i) const {
    const size_t offset = static_cast<int>(Layout) == static_cast<int>(ColMajor)
