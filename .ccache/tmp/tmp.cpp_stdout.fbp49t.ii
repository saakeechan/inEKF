    static_assert((CoeffReadCost)>=0 && (CoeffReadCost)<=HugeCost*HugeCost,"EIGEN_INTERNAL_ERROR_PLEASE_FILE_A_BUG_REPORT__INVALID_COST_VALUE");;;
  }

