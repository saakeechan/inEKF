public:

    template <typename T>
    bool operator()(T& rhs_content) const
    {

        known_get<T> getter;
        const T& lhs_content = lhs_.apply_visitor(getter);


        return Comp()(lhs_content, rhs_content);
    }

private:
    comparer& operator=(const comparer&);

};






