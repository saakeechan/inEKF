      nv[i] = nvi;
      d = degree[i] + dk - nvi;
      d = std::min<StorageIndex> (d, n - nel - nvi);
      if(head[d] != -1) last[head[d]] = i;
      next[i] = head[d];
      last[i] = -1;
      head[d] = i;
      mindeg = std::min<StorageIndex> (mindeg, d);
      degree[i] = d;
      Ci[p++] = i;
