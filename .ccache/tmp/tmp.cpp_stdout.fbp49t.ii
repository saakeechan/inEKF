    virtual bool strict_sync() = 0;
    virtual const boost::core::typeinfo& component_type() const = 0;
    virtual void* component_impl() = 0;

    private:



private:
    enum flag_type {
        f_true_eof = 1,
        f_input_closed = f_true_eof << 1,
        f_output_closed = f_input_closed << 1
    };
    int flags_;
};

