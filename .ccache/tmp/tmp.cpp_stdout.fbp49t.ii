    pstoret<double, Packet2d, ResultAlignment>(res + 2 * res_stride + 2, pmul(Packet2d(_mm_shuffle_pd(iD2,iD1,3)), d1));
    pstoret<double, Packet2d, ResultAlignment>(res + 3 * res_stride + 2, pmul(Packet2d(_mm_shuffle_pd(iD2,iD1,0)), d2));
  }
};

