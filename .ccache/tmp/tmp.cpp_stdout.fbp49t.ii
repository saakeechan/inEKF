namespace pinocchio
{



  template<typename T>
  bool compare_shared_ptr(const std::shared_ptr<T> & ptr1, const std::shared_ptr<T> & ptr2)
  {
    if (ptr1 == ptr2)
      return true;
    if (ptr1 && ptr2)
      return *ptr1.get() == *ptr2.get();
    return false;
  }
}
