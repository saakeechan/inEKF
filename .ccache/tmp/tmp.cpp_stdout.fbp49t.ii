    Scalar vtiv(const Vector3 & v) const
    {
      const Scalar & x = v[0];
      const Scalar & y = v[1];
      const Scalar & z = v[2];

      const Scalar xx = x * x;
      const Scalar xy = x * y;
      const Scalar xz = x * z;
      const Scalar yy = y * y;
      const Scalar yz = y * z;
      const Scalar zz = z * z;

      return m_data(0) * xx + m_data(2) * yy + m_data(5) * zz
             + 2. * (m_data(1) * xy + m_data(3) * xz + m_data(4) * yz);
    }
