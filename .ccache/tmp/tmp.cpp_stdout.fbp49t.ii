    }

    void disp_impl(std::ostream & os) const
    {
      os << "  R =\n" << rot << std::endl << "  p = " << trans.transpose() << std::endl;
    }




    template<typename D>
    typename SE3GroupAction<D>::ReturnType act_impl(const D & d) const
