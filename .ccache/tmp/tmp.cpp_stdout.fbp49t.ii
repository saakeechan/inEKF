# 1 "/usr/include/eigen3/Eigen/src/IterativeLinearSolvers/IncompleteLUT.h" 1 3 4
# 15 "/usr/include/eigen3/Eigen/src/IterativeLinearSolvers/IncompleteLUT.h" 3 4
namespace Eigen {

namespace internal {
# 28 "/usr/include/eigen3/Eigen/src/IterativeLinearSolvers/IncompleteLUT.h" 3 4
template <typename VectorV, typename VectorI>
Index QuickSplit(VectorV &row, VectorI &ind, Index ncut)
{
  typedef typename VectorV::RealScalar RealScalar;
  using std::swap;
  using std::abs;
  Index mid;
  Index n = row.size();
  Index first, last ;

  ncut--;
  first = 0;
  last = n-1;
  if (ncut < first || ncut > last ) return 0;

  do {
    mid = first;
    RealScalar abskey = abs(row(mid));
    for (Index j = first + 1; j <= last; j++) {
      if ( abs(row(j)) > abskey) {
        ++mid;
        swap(row(mid), row(j));
        swap(ind(mid), ind(j));
      }
    }

    swap(row(mid), row(first));
    swap(ind(mid), ind(first));

    if (mid > ncut) last = mid - 1;
    else if (mid < ncut ) first = mid + 1;
  } while (mid != ncut );

  return 0;
}

}
