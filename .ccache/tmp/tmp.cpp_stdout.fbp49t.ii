  template<typename Scalar, int Options, template<typename, int> class JointCollectionTpl>
  SE3Tpl<Scalar, Options> getRelativePlacement(
    const ModelTpl<Scalar, Options, JointCollectionTpl> & model,
    const DataTpl<Scalar, Options, JointCollectionTpl> & data,
    const JointIndex jointIdRef,
    const JointIndex jointIdTarget,
    const Convention convention)
  {
    
# 289 "/opt/openrobots/lib/pkgconfig/../../include/pinocchio/algorithm/kinematics.hxx" 3 4
   (static_cast<void> (0))
# 289 "/opt/openrobots/lib/pkgconfig/../../include/pinocchio/algorithm/kinematics.hxx"
                                                                    ;
    
# 290 "/opt/openrobots/lib/pkgconfig/../../include/pinocchio/algorithm/kinematics.hxx" 3 4
   (static_cast<void> (0))
# 290 "/opt/openrobots/lib/pkgconfig/../../include/pinocchio/algorithm/kinematics.hxx"
