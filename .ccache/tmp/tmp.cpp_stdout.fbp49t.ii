      }
      cnz = q;
    }


    dk = 0;
    nv[k] = -nvk;
    p = Cp[k];
    pk1 = (elenk == 0) ? p : cnz;
    pk2 = pk1;
    for(k1 = 1; k1 <= elenk + 1; k1++)
    {
      if(k1 > elenk)
