                ar,
                const_cast<T &>(t),
                boost::serialization::version< T >::value
            );
        }
    };



    struct load_standard {
        template<class T>
        static void invoke(Archive &ar, const T & t){
            void * x = boost::addressof(const_cast<T &>(t));
