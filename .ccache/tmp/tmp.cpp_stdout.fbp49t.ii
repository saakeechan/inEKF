      {
        nextl_col = (jj-jcol) * m;
        VectorBlock<IndexVector> repfnz_col(repfnz, nextl_col, m);
        VectorBlock<ScalarVector> dense_col(dense, nextl_col, m);

        kfnz = repfnz_col(krep);
        if ( kfnz == emptyIdxLU )
