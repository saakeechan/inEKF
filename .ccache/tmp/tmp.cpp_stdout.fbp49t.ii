template <typename Scalar>
struct digamma_impl {
 
  static Scalar run(Scalar x) {
# 241 "/usr/include/eigen3/unsupported/Eigen/CXX11/../src/SpecialFunctions/SpecialFunctionsImpl.h"
    Scalar p, q, nz, s, w, y;
    bool negative = false;

    const Scalar nan = NumTraits<Scalar>::quiet_NaN();
    const Scalar m_pi = Scalar(
# 245 "/usr/include/eigen3/unsupported/Eigen/CXX11/../src/SpecialFunctions/SpecialFunctionsImpl.h" 3 4
                              3.141592653589793238462643383279502884197169399375105820974944592307816406L
# 245 "/usr/include/eigen3/unsupported/Eigen/CXX11/../src/SpecialFunctions/SpecialFunctionsImpl.h"
                                      );

    const Scalar zero = Scalar(0);
    const Scalar one = Scalar(1);
    const Scalar half = Scalar(0.5);
    nz = zero;

    if (x <= zero) {
      negative = true;
      q = x;
      p = numext::floor(q);
      if (p == q) {
        return nan;
      }



      nz = q - p;
      if (nz != half) {
        if (nz > half) {
          p += one;
          nz = q - p;
        }
        nz = m_pi / numext::tan(m_pi * nz);
      }
      else {
        nz = zero;
      }
      x = one - x;
    }


