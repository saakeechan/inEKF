    template<class Ptree>
    void read_xml(const std::string &filename,
                  Ptree &pt,
                  int flags = 0,
                  const std::locale &loc = std::locale())
    {
        (static_cast<void> (0));
        std::basic_ifstream<typename Ptree::key_type::value_type>
            stream(filename.c_str());
        if (!stream)
            ::boost::throw_exception(xml_parser_error( "cannot open file", filename, 0), ::boost::source_location("/usr/include/boost/property_tree/xml_parser.hpp", 82, __PRETTY_FUNCTION__))
                                                 ;
        stream.imbue(loc);
        read_xml_internal(stream, pt, flags, filename);
    }
