          tempVector.restart();
          if (IsLower)
          {
            if (it.index()==i)
              ++it;
            for(; it; ++it)
              tempVector.coeffRef(it.index()) -= ci * it.value();
          }
          else
          {
            for(; it && it.index()<i; ++it)
              tempVector.coeffRef(it.index()) -= ci * it.value();
          }
        }
      }


      Index count = 0;

      for (typename AmbiVector<Scalar,StorageIndex>::Iterator it(tempVector ); it; ++it)
      {
        ++ count;



        res.insert(it.index(), col) = it.value();
      }

    }
    res.finalize();
    other = res.markAsRValue();
  }
};

}


