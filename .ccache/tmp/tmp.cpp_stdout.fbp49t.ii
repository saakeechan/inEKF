namespace pinocchio
{
  namespace internal
  {

    enum ComparisonOperators
    {
      LT,
      LE,
      EQ,
      GE,
      GT
    };

    template<typename LhsType, typename RhsType, typename ThenType, typename ElseType>
    struct if_then_else_impl;

    template<typename LhsType, typename RhsType>
