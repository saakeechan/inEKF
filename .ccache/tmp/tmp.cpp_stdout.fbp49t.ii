    template<typename Str>
    Str widen(const char *text)
    {
        Str result;
        while (*text)
        {
            result += typename Str::value_type(*text);
            ++text;
        }
        return result;
    }


    template<typename Str, typename char_type>
    Str narrow(const char_type *text)
    {
