enum class copy_options : unsigned int
{
  none = 0u,


  skip_existing = 1u,
  overwrite_existing = 1u << 1,
  update_existing = 1u << 2,


  recursive = 1u << 8,
  copy_symlinks = 1u << 9,
  skip_symlinks = 1u << 10,
  directories_only = 1u << 11,
  create_symlinks = 1u << 12,
  create_hard_links = 1u << 13,
  _detail_recursing = 1u << 14
}
;

